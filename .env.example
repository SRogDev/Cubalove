# Supabase (self-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.datingcuba.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase service role (solo servidor — NUNCA exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://datingcuba.com
NEXT_PUBLIC_CDN_URL=https://cdn.datingcuba.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PLUS_ID=price_...
STRIPE_PRICE_VIP_ID=price_...

# Web Push (VAPID keys — generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Internal API secret (para llamadas server-to-server)
INTERNAL_API_SECRET=your-internal-secret

# S3-compatible object storage (backend for self-hosted Supabase Storage)
# Works with Hetzner Object Storage, DigitalOcean Spaces, MinIO, AWS S3...
# Examples:
#   Hetzner: S3_ENDPOINT=https://nbg1.your-objectstorage.com
#   DO Spaces: S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
#   MinIO (local): S3_ENDPOINT=http://minio:9000  (also set S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=us-east-1
S3_BUCKET=cubalove
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Comma-separated extra image hostnames allowed by next/image + CSP
# (your S3 endpoint hostname, wildcards supported, e.g. *.nbg1.your-objectstorage.com).
# Leave empty to allow none.
STORAGE_IMAGE_HOSTNAMES=*.nbg1.your-objectstorage.com

# Redis (Bun native client)
REDIS_URL=redis://localhost:6379

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── AI Recommendations ───────────────────────────────────────────────────────
# Google AI Studio API key — used for Gemini 2.5 Flash + text-embedding-004
# Get one free at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# Secret token for the weekly recommendations cron endpoint
# POST /api/recommendations/calculate requires: Authorization: Bearer CRON_SECRET
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
